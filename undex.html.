    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Init Lucide Icons
        lucide.createIcons();

        // Single Page Tab Navigation Logic
        function switchTab(tabId) {
            // Hide all tab contents
            const contents = document.querySelectorAll('.tab-content');
            contents.forEach(content => content.classList.add('hidden'));

            // Remove active classes from nav buttons
            const navButtons = document.querySelectorAll('.nav-btn');
            navButtons.forEach(btn => btn.classList.remove('active-tab'));

            const mobNavButtons = document.querySelectorAll('.mob-nav-btn');
            mobNavButtons.forEach(btn => btn.classList.remove('active-mobile-tab'));

            // Show selected section
            const selectedSection = document.getElementById(`section-${tabId}`);
            if (selectedSection) {
                selectedSection.classList.remove('hidden');
            }

            // Set active nav styles
            const activeNav = document.getElementById(`nav-${tabId}`);
            if (activeNav) {
                activeNav.classList.add('active-tab');
            }

            const activeMobNav = document.getElementById(`mob-nav-${tabId}`);
            if (activeMobNav) {
                activeMobNav.classList.add('active-mobile-tab');
            }

            // Close mobile menu if open
            document.getElementById('mobile-menu').classList.add('hidden');

            // Scroll top smooth
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Mobile Menu Toggle
        document.getElementById('mobile-menu-btn').addEventListener('click', function() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        });

        // Modal Berita Logic
        function openNewsModal(title, date, content) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-date').innerText = date;
            document.getElementById('modal-content').innerText = content;
            document.getElementById('news-modal').classList.remove('hidden');
        }

        function closeNewsModal() {
            document.getElementById('news-modal').classList.add('hidden');
        }

        // Filter Galeri Logic
        function filterGallery(category) {
            const items = document.querySelectorAll('.gallery-item');
            items.forEach(item => {
                if (category === 'all' || item.classList.contains(category)) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });

            // Active button state for gallery
            const filterBtns = document.querySelectorAll('.gallery-filter-btn');
            filterBtns.forEach(btn => {
                btn.classList.remove('bg-brand-blue', 'text-white');
                btn.classList.add('bg-white', 'text-slate-600');
            });
            event.target.classList.remove('bg-white', 'text-slate-600');
            event.target.classList.add('bg-brand-blue', 'text-white');
        }

        // Form Handlers
        function handlePPDBSubmit(event) {
            event.preventDefault();
            const alertBox = document.getElementById('ppdb-alert');
            alertBox.classList.remove('hidden');
            document.getElementById('form-ppdb').reset();
        }

        function handleContactSubmit(event) {
            event.preventDefault();
            const alertBox = document.getElementById('contact-alert');
            alertBox.classList.remove('hidden');
            document.getElementById('form-kontak').reset();
            setTimeout(() => {
                alertBox.classList.add('hidden');
            }, 4000);
        }

        // Set Default Active Tab on Load
        window.addEventListener('DOMContentLoaded', () => {
            switchTab('beranda');
        });
    </script>
